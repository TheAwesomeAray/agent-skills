{
  "type": "object",
  "required": ["executive_summary", "reviewed", "added", "recommendations"],
  "properties": {
    "executive_summary": { "type": "string", "minLength": 1 },
    "application": { "type": "string" },
    "reviewed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "evidence"],
        "properties": {
          "id": { "type": "string", "description": "The finding's stable id (solid-xxxxxx)" },
          "action": { "enum": ["keep", "dismiss", "adjust"] },
          "severity": { "$ref": "common.json#/definitions/severity" },
          "reason": { "type": "string" },
          "recommendation": { "type": "string" },
          "evidence": { "$ref": "common.json#/definitions/evidence" },
          "related": { "$ref": "common.json#/definitions/related" }
        }
      }
    },
    "out_of_scope": { "$ref": "common.json#/definitions/out_of_scope" },
    "added": {
      "type": "array",
      "items": { "allOf": [{ "$ref": "common.json#/definitions/added_finding" }, { "required": ["evidence"] }] }
    },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "register_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["present", "fixed"] },
          "evidence": { "$ref": "common.json#/definitions/evidence" }
        }
      }
    }
  }
}
