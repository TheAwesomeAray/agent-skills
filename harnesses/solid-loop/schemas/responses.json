{
  "type": "object",
  "required": ["round", "responses"],
  "properties": {
    "round": { "type": "integer", "minimum": 1 },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["challenge_id", "response", "argument", "evidence"],
        "properties": {
          "challenge_id": { "type": "string" },
          "response": { "enum": ["concede", "revise", "defend"] },
          "argument": { "type": "string", "minLength": 1 },
          "revised_outcome": { "anyOf": [{ "$ref": "common.json#/definitions/outcome" }, { "type": "null" }] },
          "evidence": { "$ref": "common.json#/definitions/evidence_optional" }
        }
      }
    }
  }
}
